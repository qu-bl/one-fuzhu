{
  "schemaVersion": 2,
  "contractVersion": "10.0.0",
  "purpose": "供 AI 自主读取的远程规则库目录；调用端不根据关键词选择规则。",
  "entry": "ai-rules/README.md",
  "release": "ai-rules/rules.json",
  "catalog": {
    "workflow": "ai-rules/guidance.json",
    "generatedProfile": "ai-rules/generation-profile.json",
    "examples": "ai-rules/examples.json",
    "scenarioGuides": {
      "applicationScript": "ai-rules/application-script.md",
      "resourcePackage": "ai-rules/resource-package.md"
    },
    "contract": "contracts/schema-v3/contract.json",
    "contractRelease": "contracts/schema-v3/release.json",
    "resourcePackageSchema": "contracts/schema-v3/resource-package.schema.json"
  },
  "profilePointers": {
    "manifest": "/manifest",
    "ui": "/ui",
    "script": "/script",
    "network": "/network",
    "qvmi": "/qvmi",
    "storage": "/script/storage"
  },
  "contractPointers": {
    "manifest": "/manifest",
    "ui": "/ui",
    "script": "/script",
    "network": "/network",
    "qvmi": "/qvmi",
    "resources": "/resources",
    "archive": "/archive"
  },
  "readingPolicy": [
    "先读取 workflow 与当前场景指南。",
    "根据任务自行选择 generatedProfile 的分区；不要一次读取无关分区。",
    "自动摘要不足时再读取 contract 的对应分区。",
    "只有新建、大幅重写、明确索要示例或语法不确定时读取 examples。",
    "完整 JSON Schema 留给宿主校验。"
  ]
}
