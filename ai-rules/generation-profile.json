{
  "schemaVersion": 1,
  "contractVersion": "5.1.0",
  "purpose": "模型生成前使用的精简索引；最终结果仍由宿主使用完整契约和 JSON Schema 校验。",
  "manifest": {
    "required": [
      "schemaVersion",
      "id",
      "version",
      "name",
      "author",
      "preview",
      "rive",
      "values",
      "capabilities",
      "bindings",
      "assets",
      "ui"
    ],
    "optional": [
      "description",
      "javascript",
      "$schema"
    ],
    "fixedFiles": {
      "preview": "preview.webp",
      "rive": "main.riv",
      "javascript": "main.js"
    },
    "valueTypes": [
      "number",
      "string",
      "boolean",
      "color",
      "trigger",
      "enum",
      "resource",
      "image",
      "artboard",
      "list",
      "viewModel"
    ],
    "packageScriptEntryFunction": "defineResourcePackage"
  },
  "ui": {
    "runtimeSemantics": {
      "dynamicBindingTransport": "qvmi",
      "bindingScope": "owner",
      "observeUniquePathsPerComponent": true,
      "reevaluateAllBindingsForChangedPath": true,
      "republishDerivedUiState": false,
      "nativeComponents": true,
      "groupDisabledRecursively": true,
      "nativeComponentIntersectionOnly": true,
      "customDrawingAllowed": false
    },
    "buttonStyleSemantics": {
      "appearancePolicy": "hostNativeOnly",
      "hostAppearanceOverrides": false,
      "plain": "nativeText",
      "filled": "nativeProminent",
      "unsupportedAppearancePolicy": "reject"
    },
    "allowedFieldsByType": {
      "group": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "children",
        "layout",
        "gap",
        "align",
        "valign",
        "scroll",
        "padding",
        "enabled"
      ],
      "text": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "text",
        "format",
        "size",
        "multiline",
        "lines",
        "copyable"
      ],
      "spacer": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "space"
      ],
      "button": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "text",
        "format",
        "style",
        "action",
        "acceptedFileExtensions",
        "maxBytes",
        "enabled"
      ],
      "input": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "placeholder",
        "inputMode",
        "lines",
        "min",
        "max",
        "step",
        "enabled"
      ],
      "toggle": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "enabled"
      ],
      "slider": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "min",
        "max",
        "step",
        "format",
        "enabled"
      ],
      "choice": [
        "bindings",
        "description",
        "flex",
        "hug",
        "id",
        "label",
        "type",
        "visible",
        "options",
        "selectionMin",
        "selectionMax",
        "presentation",
        "enabled"
      ]
    },
    "requiredByType": {
      "group": [
        "id",
        "type",
        "layout",
        "label"
      ],
      "text": [
        "id",
        "type",
        "label"
      ],
      "spacer": [
        "id",
        "type",
        "label"
      ],
      "button": [
        "id",
        "type",
        "label",
        "action"
      ],
      "input": [
        "id",
        "type",
        "label",
        "inputMode"
      ],
      "toggle": [
        "id",
        "type",
        "label"
      ],
      "slider": [
        "id",
        "type",
        "label"
      ],
      "choice": [
        "id",
        "type",
        "label",
        "selectionMax",
        "presentation"
      ]
    },
    "oneOfRequiredByType": {},
    "requiredWhen": [
      {
        "id": "resource-package-description",
        "when": {
          "context": "resourcePackage"
        },
        "required": [
          "description"
        ]
      },
      {
        "id": "resource-package-text-content",
        "when": {
          "context": "resourcePackage",
          "type": "text"
        },
        "oneOf": [
          "text",
          "bindings.text"
        ],
        "allowedScopes": [
          "persistent"
        ]
      },
      {
        "id": "resource-package-emit-button",
        "when": {
          "context": "resourcePackage",
          "type": "button",
          "action": "emit"
        },
        "oneOf": [
          "text",
          "bindings.text"
        ],
        "forbiddenBindings": [
          "value"
        ],
        "allowedScopes": [
          "runtime"
        ]
      },
      {
        "id": "file-button-value-binding",
        "when": {
          "type": "button",
          "valueControl": true
        },
        "requiredBindings": [
          "value"
        ]
      }
    ],
    "bindingsByType": {
      "group": [
        "label",
        "description",
        "visible",
        "enabled",
        "error"
      ],
      "text": [
        "text",
        "visible"
      ],
      "spacer": [
        "visible"
      ],
      "button": [
        "text",
        "visible",
        "enabled",
        "error",
        "value"
      ],
      "input": [
        "value",
        "label",
        "description",
        "placeholder",
        "visible",
        "enabled",
        "readOnly",
        "error"
      ],
      "toggle": [
        "value",
        "label",
        "description",
        "visible",
        "enabled",
        "error"
      ],
      "slider": [
        "value",
        "min",
        "max",
        "step",
        "label",
        "description",
        "visible",
        "enabled",
        "error"
      ],
      "choice": [
        "value",
        "options",
        "label",
        "description",
        "visible",
        "enabled",
        "error"
      ]
    },
    "bindingKinds": {
      "value": "value",
      "label": "text",
      "description": "text",
      "text": "text",
      "placeholder": "text",
      "error": "text",
      "visible": "condition",
      "enabled": "condition",
      "readOnly": "condition",
      "options": "list",
      "min": "number",
      "max": "number",
      "step": "number"
    },
    "bindingDefaults": {
      "visible": true,
      "enabled": true,
      "readOnly": false
    },
    "requiredBindingsByType": {
      "group": [],
      "text": [],
      "spacer": [],
      "button": [],
      "input": [
        "value"
      ],
      "toggle": [
        "value"
      ],
      "slider": [
        "value"
      ],
      "choice": [
        "value"
      ]
    },
    "enums": {
      "scope": [
        "persistent",
        "runtime"
      ],
      "density": [
        "normal",
        "compact"
      ],
      "slot": [
        "dialog",
        "scriptUi",
        "applicationScript",
        "packageBuilder"
      ],
      "size": [
        "sm",
        "md",
        "lg"
      ],
      "style": [
        "plain",
        "filled"
      ],
      "layout": [
        "column",
        "row",
        "stack"
      ],
      "action": [
        "emit",
        "pickFile",
        "pickResource"
      ],
      "inputMode": [
        "text",
        "multiline",
        "number",
        "password"
      ],
      "presentation": [
        "list"
      ],
      "align": [
        "start",
        "center",
        "end"
      ],
      "valign": [
        "top",
        "center",
        "bottom"
      ]
    },
    "limits": {
      "setsMax": 8,
      "componentsPerSetMax": 32,
      "childrenMax": 32,
      "depthMax": 6,
      "optionsMax": 64,
      "listItemsMax": 64,
      "propertyPathSegmentsMax": 8,
      "extensionsMax": 16,
      "labelMax": 200,
      "idMax": 64,
      "linesMin": 1,
      "linesMax": 20,
      "decimalsMin": 0,
      "decimalsMax": 6,
      "spaceMax": 200,
      "paddingMax": 64
    }
  },
  "script": {
    "applicationEntryFunction": "defineQuScript",
    "packageEntryFunction": "defineResourcePackage",
    "applicationOnlyOperations": [
      "values.define",
      "values.remove",
      "values.list",
      "ui.declare",
      "ui.clear",
      "editor.read",
      "editor.apply"
    ],
    "hostOperations": [
      "values.get",
      "values.define",
      "values.remove",
      "values.list",
      "values.set",
      "values.observe",
      "values.trigger",
      "ui.open",
      "ui.declare",
      "ui.clear",
      "editor.read",
      "editor.apply",
      "network.request",
      "network.download",
      "network.upload",
      "network.stream",
      "network.webSocket.open",
      "network.webSocket.send",
      "network.webSocket.close",
      "persistence.save",
      "persistence.restore",
      "resources.token",
      "resources.readText",
      "resources.readBinary",
      "rive.state",
      "rive.load",
      "rive.font.set"
    ]
  }
}
