        "oneOf": [
          "text",
          "bindings.text"
        ],
        "allowedScopes": [
          "persistent"
        ]
      },
      {
        "id": "resource-package-emit-button",
        "when": {
          "context": "resourcePackage",
          "type": "button",
          "action": "emit"
        },
        "oneOf": [
          "text",
          "bindings.text"
        ],
        "forbiddenBindings": [
          "value"
        ],
        "allowedScopes": [
          "runtime"
        ]
      },
      {
        "id": "file-button-value-binding",
        "when": {
          "type": "button",
          "valueControl": true
        },
        "required": [
          "maxBytes"
        ],
        "requiredBindings": [
          "value"
        ]
      }
    ],
