{
  "contractVersion": "8.0.0",
  "sourceOfTruth": "one-fuzhu published schema-v3 contract; HarmonyOS is the behavior baseline",
  "builder": {
    "projectNameMax": 40,
    "projectNamePattern": "^[A-Za-z0-9一-龥]+$"
  },
  "manifest": {
    "required": [
      "schemaVersion",
      "id",
      "version",
      "name",
      "author",
      "preview",
      "rive",
      "values",
      "capabilities",
      "bindings",
      "assets",
      "ui"
    ],
    "optional": [
      "description",
      "javascript",
      "$schema"
    ],
    "nested": {
      "rive": [
        "file",
        "artboard",
        "stateMachine",
        "viewModel",
        "instance",
        "layout"
      ],
      "rive.layout": [
        "fit",
        "alignment",
        "layoutScaleFactor"
      ],
      "javascript": [
        "entry",
        "networkDomains"
      ],
      "values[]": [
        "path",
        "type",
        "defaultValue",
        "writable"
      ],
      "capabilities": [
        "observe",
        "trigger"
      ],
      "bindings[]": [
        "id",
        "qu",
        "quType",
        "rive",
        "riveType",
        "direction",
        "mode",
        "required",
        "transform"
      ],
      "bindings[].transform": [
        "scale",
        "offset",
        "invert",
        "clamp"
      ],
      "assets": [
        "audio"
      ],
      "assets.audio[]": [
        "id",
        "file",
        "usage",
        "volume",
        "loop"
      ],
      "ui[]": [
        "id",
        "title",
        "scope",
        "components"
      ]
    },
    "valueTypes": [
      "number",
      "string",
      "boolean",
      "color",
      "trigger",
      "enum",
      "resource",
      "image",
      "artboard",
      "list",
      "viewModel"
    ],
    "bindingSourceTypes": [
      "number",
      "string",
      "boolean",
      "color",
      "trigger",
      "enum",
      "resource",
      "image",
      "artboard",
      "list",
      "viewModel",
      "object"
    ],
    "riveTypes": [
      "number",
      "string",
      "boolean",
      "color",
      "trigger",
      "enum",
      "image",
      "artboard",
      "list",
      "viewModel"
    ],
    "validation": {
      "fixedFiles": {
        "preview": "preview.webp",
        "rive": "main.riv",
        "javascript": "main.js"
      },
      "patterns": {
        "id": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*)+$",
        "version": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
        "identifier": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
        "qvmiPath": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9*]+)+$",
        "packageValuePath": "^package\\.[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*$",
        "networkDomain": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$",
        "audioFile": "^assets/.+\\.(?:mp3|wav|ogg|flac|aac|m4a)$",
        "fileExtension": "^\\.[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$"
      },
      "limits": {
        "nameMax": 128,
        "authorMax": 128,
        "descriptionMax": 1024,
        "riveNameMax": 128,
        "rivePropertySegmentsMax": 16,
        "rivePropertySegmentMax": 128,
        "packageComponentDescriptionMax": 512,
        "packageActionTextMax": 64,
        "uiSetsMax": 8
      },
      "packageScriptEntryFunction": "defineResourcePackage",
      "runtimePathPrefix": "package.ui.",
      "triggerPathPrefix": "runtime.",
      "forbiddenTriggerPrefixes": [
        "runtime.network.",
        "runtime.storage."
      ],
      "binding": {
        "directions": [
          "toRive",
          "fromRive",
          "twoWay"
        ],
        "mode": "latest",
        "transformSourceType": "number",
        "transformTargetType": "number",
        "transformDirection": "toRive",
        "structuredRiveTypes": [
          "image",
          "artboard",
          "list",
          "viewModel"
        ],
        "resourceToImageDirection": "toRive",
        "triggerTwoWayAllowed": false,
        "clampLength": 2
      },
      "audio": {
        "usages": [
          "effect",
          "music"
        ],
        "volumeMin": 0,
        "volumeMax": 1,
        "loopUsage": "music"
      },
      "packageFiles": {
        "required": [
          "resource-package.json",
          "main.riv",
          "preview.webp"
        ],
        "optional": [
          "main.js"
        ],
        "assetPrefix": "assets/",
        "scriptDeclarationMatchesFile": true
      },
      "rive": {
        "fits": [
          "contain",
          "cover",
          "fill",
          "fitWidth",
          "fitHeight",
          "none",
          "scaleDown",
          "layout"
        ],
        "alignments": [
          "center",
          "topLeft",
          "topCenter",
          "topRight",
          "centerLeft",
          "centerRight",
          "bottomLeft",
          "bottomCenter",
          "bottomRight"
        ],
        "viewModelAndInstanceTogether": true,
        "bindingsRequireViewModel": true,
        "layoutScaleFactorPositive": true
      },
      "forbiddenValueFields": [
        "persistent"
      ]
    }
  },
