{
  "schemaVersion": 3,
  "id": "com.example.clock",
  "version": "1.0.0",
  "name": "时钟",
  "author": "示例作者",
  "preview": "preview.webp",
  "rive": {
    "file": "main.riv",
    "artboard": "Main",
    "stateMachine": "State Machine 1",
    "layout": {
      "fit": "contain",
      "alignment": "center"
    }
  },
  "values": [],
  "capabilities": {
    "observe": [
      "system.time.epochMs"
    ],
    "trigger": []
  },
  "bindings": [],
  "assets": {
    "audio": []
  },
  "ui": [
    {
      "id": "bindings",
      "title": "动态绑定覆盖",
      "scope": "persistent",
      "components": [
        {
          "id": "root",
          "type": "group",
          "label": "设置",
          "layout": "column",
          "children": [
            {
              "id": "copy",
              "type": "text",
              "label": "可复制文字",
              "copyable": true,
              "bindings": {
                "text": {
                  "path": "ui.copy",
                  "fallback": "可复制文字"
                },
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                }
              },
              "description": "可复制文字"
            },
            {
              "id": "flexibleSpace",
              "type": "spacer",
              "label": "间隔",
              "bindings": {
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                }
              },
              "description": "间隔"
            },
            {
              "id": "pick",
              "type": "button",
              "label": "选择资源",
              "action": "pickFile",
              "maxBytes": 10485760,
              "bindings": {
                "value": {
                  "path": "ui.resource",
                  "type": "resource",
                  "default": ""
                },
                "text": {
                  "path": "ui.buttonText",
                  "fallback": "选择资源"
                },
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                },
                "enabled": {
                  "path": "ui.enabled",
                  "equals": true,
                  "fallback": true
                },
                "error": {
                  "path": "ui.error",
                  "fallback": ""
                }
              },
              "description": "选择资源"
            },
            {
              "id": "name",
              "type": "input",
              "label": "名称",
              "inputMode": "text",
              "bindings": {
                "value": {
                  "path": "ui.name",
                  "type": "string",
                  "default": ""
                },
                "label": {
                  "path": "ui.nameLabel",
                  "fallback": "名称"
                },
                "description": {
                  "path": "ui.nameHelp",
                  "fallback": "输入名称"
                },
                "placeholder": {
                  "path": "ui.placeholder",
                  "fallback": "请输入"
                },
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                },
                "enabled": {
                  "path": "ui.enabled",
                  "equals": true,
                  "fallback": true
                },
                "readOnly": {
                  "path": "ui.readOnly",
                  "equals": true,
                  "fallback": false
                },
                "error": {
                  "path": "ui.error",
                  "fallback": ""
                }
              },
              "description": "名称"
            },
            {
              "id": "switch",
              "type": "toggle",
              "label": "开关",
              "bindings": {
                "value": {
                  "path": "ui.switch",
                  "type": "boolean",
                  "default": false
                },
                "label": {
                  "path": "ui.switchLabel",
                  "fallback": "开关"
                },
                "description": {
                  "path": "ui.switchHelp",
                  "fallback": "是否启用"
                },
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                },
                "enabled": {
                  "path": "ui.enabled",
                  "equals": true,
                  "fallback": true
                },
                "error": {
                  "path": "ui.error",
                  "fallback": ""
                }
              },
              "description": "开关"
            },
            {
              "id": "amount",
              "type": "slider",
              "label": "数值",
              "bindings": {
                "value": {
                  "path": "ui.amount",
                  "type": "number",
                  "default": 0
                },
                "min": {
                  "path": "ui.min",
                  "fallback": 0
                },
                "max": {
                  "path": "ui.max",
                  "fallback": 100
                },
                "step": {
                  "path": "ui.step",
                  "fallback": 1
                },
                "label": {
                  "path": "ui.amountLabel",
                  "fallback": "数值"
                },
                "description": {
                  "path": "ui.amountHelp",
                  "fallback": "拖动调整"
                },
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                },
                "enabled": {
                  "path": "ui.enabled",
                  "equals": true,
                  "fallback": true
                },
                "error": {
                  "path": "ui.error",
                  "fallback": ""
                }
              },
              "description": "数值"
            },
            {
              "id": "mode",
              "type": "choice",
              "label": "模式",
              "bindings": {
                "value": {
                  "path": "ui.mode",
                  "type": "enum",
                  "default": "a"
                },
                "options": {
                  "path": "ui.options",
                  "fallback": [
                    {
                      "label": "A",
                      "value": "a"
                    },
                    {
                      "label": "B",
                      "value": "b"
                    }
                  ]
                },
                "label": {
                  "path": "ui.modeLabel",
                  "fallback": "模式"
                },
                "description": {
                  "path": "ui.modeHelp",
                  "fallback": "选择模式"
                },
                "visible": {
                  "path": "ui.visible",
                  "equals": true,
                  "fallback": true
                },
                "enabled": {
                  "path": "ui.enabled",
                  "equals": true,
                  "fallback": true
                },
                "error": {
                  "path": "ui.error",
                  "fallback": ""
                }
              },
              "description": "模式"
            }
          ],
          "bindings": {
            "label": {
              "path": "ui.groupLabel",
              "fallback": "设置"
            },
            "description": {
              "path": "ui.groupHelp",
              "fallback": "动态设置"
            },
            "visible": {
              "path": "ui.visible",
              "equals": true,
              "fallback": true
            },
            "enabled": {
              "path": "ui.enabled",
              "equals": true,
              "fallback": true
            },
            "error": {
              "path": "ui.error",
              "fallback": ""
            }
          },
          "description": "设置"
        }
      ]
    }
  ]
}
