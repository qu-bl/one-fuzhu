{
  "schemaVersion": 3,
  "id": "com.example.clock",
  "version": "1.0.0",
  "name": "时钟",
  "author": "示例作者",
  "preview": "preview.webp",
  "rive": {
    "file": "main.riv",
    "artboard": "Main",
    "stateMachine": "State Machine 1",
    "layout": {
      "fit": "contain",
      "alignment": "center"
    }
  },
  "values": [],
  "capabilities": {
    "observe": [
      "system.time.epochMs"
    ],
    "trigger": []
  },
  "bindings": [],
  "assets": {
    "audio": []
  },
  "ui": [
    {
      "id": "settings",
      "title": "设置",
      "scope": "persistent",
      "components": [
        {
          "id": "layout",
          "type": "group",
          "label": "一行",
          "description": "组合",
          "children": [
            {
              "id": "title",
              "type": "text",
              "label": "标题",
              "description": "标题文字",
              "text": "你好",
              "platformDecoration": 4
            },
            {
              "id": "name",
              "type": "input",
              "label": "名称",
              "description": "用户输入",
              "hug": true,
              "inputMode": "text",
              "bindings": {
                "value": {
                  "path": "name",
                  "type": "string",
                  "default": "默认"
                }
              }
            }
          ],
          "layout": "row"
        }
      ]
    }
  ]
}
